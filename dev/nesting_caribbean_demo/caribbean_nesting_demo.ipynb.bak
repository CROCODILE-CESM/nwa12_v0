     "shell.execute_reply": "2026-07-02T18:13:52.131100Z"
    }
   },
   "outputs": [],
   "source": [
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "from pathlib import Path\n",
    "from CrocoDash.grid import Grid\n",
    "from CrocoDash.topo import Topo\n",
    "from CrocoDash.vgrid import VGrid\n",
    "from CrocoDash.case import Case\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-3",
   "metadata": {},
   "source": [
    "## Step 1 — Paths and reference files (parent, middle child, tiny child)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-4",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-02T18:13:52.142693Z",
     "iopub.status.busy": "2026-07-02T18:13:52.142502Z",
     "iopub.status.idle": "2026-07-02T18:13:52.181779Z",
     "shell.execute_reply": "2026-07-02T18:13:52.181257Z"
    }
   },
   "outputs": [],
   "source": "CESMROOT = Path(\"~/work/installs/CROCESM_workshop_2025\").expanduser()\nPROJECT  = \"ncgd0011\"\nGEBCO    = Path(\"/glade/derecho/scratch/manishrv/ice/croc/gebco/GEBCO_2024.nc\")\n\n# --- Parent (carib12) ---\nPARENT_CASE  = Path(\"~/croc_cases/carib12_nesting_demo\").expanduser()\nPARENT_INPUT = Path(\"/glade/u/home/manishrv/scratch/croc_input/carib12_nesting_demo\")\n\n# Reference case files from Ajanney's carib12 run\nREF_INPUT     = Path(\"/glade/work/ajanney/CrocoDash_Input/carib12_credit_tides_runoff_02/ocnice\")\nREF_SUPERGRID = REF_INPUT / \"ocean_hgrid_carib_012_hgrid_df37c4.nc\"\nREF_TOPOG     = REF_INPUT / \"ocean_topog_carib_012_hgrid_df37c4.nc\"\nREF_VGRID     = REF_INPUT / \"vgrid_65L_20200626.nc\"\n\n# --- Middle child (1/24°, eastern Caribbean) ---\nMID_CASE  = Path(\"~/croc_cases/carib_mid_child\").expanduser()\nMID_INPUT = Path(\"/glade/u/home/manishrv/scratch/croc_input/carib_mid_child\")\n\n# --- Tiny child (1/48°, southern Caribbean) ---\nTINY_CASE  = Path(\"~/croc_cases/carib_tiny_child\").expanduser()\nTINY_INPUT = Path(\"/glade/u/home/manishrv/scratch/croc_input/carib_tiny_child\")\n\n# --- Nesting sources (each child's OBC comes from the next coarser domain's own MOM6 output) ---\nPARENT_NESTING_OUTPUT = Path(\"~/scratch/archive/carib12_nesting_demo/ocn/hist/nesting_files\").expanduser()\nMID_NESTING_OUTPUT    = Path(\"~/scratch/archive/carib_mid_child/ocn/hist/nesting_files\").expanduser()\n"
  },
  {
   "cell_type": "markdown",
   "id": "cell-5",
   "metadata": {},
   "source": [
    "## Step 2 — Horizontal grids (parent, middle child, tiny child)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-6",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-02T18:13:52.194343Z",
     "iopub.status.busy": "2026-07-02T18:13:52.194153Z",
     "iopub.status.idle": "2026-07-02T18:13:57.190513Z",
     "shell.execute_reply": "2026-07-02T18:13:57.189772Z"
    }
   },
   "outputs": [],
   "source": "# Parent — load the existing carib12 supergrid directly, no need to re-generate\nparent_grid = Grid.from_supergrid(REF_SUPERGRID, name=\"carib12_nesting_demo\")\n\n# Middle child — 1/48°, 4x refinement over the 1/12° parent\n# shifted 2.5° east of the original placement\nmid_grid = Grid(\n    resolution = 1/48,\n    xstart     = -73.5,\n    lenx       = 11.0,   # -73.5 → -62.5\n    ystart     = 10.0,\n    leny       = 8.0,    # 10 → 18\n    name       = \"carib_mid_child\",\n)\n\n# Tiny child — 1/192°, 4x refinement over the 1/48° middle child\n# shifted 2.5° east of the original placement\ntiny_grid = Grid(\n    resolution = 1/192,\n    xstart     = -70.5,\n    lenx       = 4.0,    # -70.5 → -66.5\n    ystart     = 12.0,\n    leny       = 4.0,    # 12 → 16\n    name       = \"carib_tiny_child\",\n)\n\nprint(f\"Parent grid: {parent_grid}\")\nprint(f\"Middle child grid: {mid_grid}\")\nprint(f\"Tiny child grid: {tiny_grid}\")\n"
  },
  {
   "cell_type": "markdown",
   "id": "4a81b20a",
   "metadata": {},
   "source": [
    "### Grid check — visualize the nested footprints before generating bathymetry\n",
    "\n",
    "Before paying the cost of regridding GEBCO bathymetry for each domain, sanity-check the grid\n",
    "geometry alone: footprints, resolution (mesh density), and how they sit relative to the coastline.\n",
    "This only touches `Grid` objects (pure geometry, already created above) — no bathymetry regridding.\n",
    "Adjust `xstart`/`ystart`/`lenx`/`leny`/`resolution` above and re-run this cell until the boxes look right.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "39da76ef",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-02T18:13:57.198292Z",
     "iopub.status.busy": "2026-07-02T18:13:57.198162Z",
     "iopub.status.idle": "2026-07-02T18:14:02.066559Z",
     "shell.execute_reply": "2026-07-02T18:14:02.066129Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "import cartopy.crs as ccrs\n",
    "import cartopy.feature as cfeature\n",
    "\n",
    "GRIDS = {\n",
    "    \"parent (carib12, 1/12°)\": (parent_grid, \"#4C72B0\", 10),\n",
    "    \"middle child (1/48°)\": (mid_grid, \"#DD8452\", 5),\n",
    "    \"tiny child (1/192°)\": (tiny_grid, \"#C44E52\", 2),\n",
    "}\n",
    "\n",
    "# crop the parent's huge basin-scale grid down to just the region around the nested children\n",
    "LON_CROP = (-80.0, -60.0)\n",
    "LAT_CROP = (7.0, 21.0)\n",
    "\n",
    "def crop_mesh(lon2d, lat2d, lon_range, lat_range):\n",
    "    in_box = (lon2d >= lon_range[0]) & (lon2d <= lon_range[1]) & (lat2d >= lat_range[0]) & (lat2d <= lat_range[1])\n",
    "    rows = np.where(in_box.any(axis=1))[0]\n",
    "    cols = np.where(in_box.any(axis=0))[0]\n",
    "    if len(rows) == 0 or len(cols) == 0:\n",
    "        return lon2d, lat2d\n",
    "    r0, r1 = rows.min(), rows.max() + 1\n",
    "    c0, c1 = cols.min(), cols.max() + 1\n",
    "    return lon2d[r0:r1, c0:c1], lat2d[r0:r1, c0:c1]\n",
    "\n",
    "def draw_mesh(ax, lon2d, lat2d, step, color, zorder):\n",
    "    tf = ccrs.PlateCarree()\n",
    "    ax.plot(lon2d[::step, :].T, lat2d[::step, :].T, color=color, linewidth=0.4, alpha=0.6, zorder=zorder, transform=tf)\n",
    "    ax.plot(lon2d[:, ::step], lat2d[:, ::step], color=color, linewidth=0.4, alpha=0.6, zorder=zorder, transform=tf)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 7), subplot_kw={\"projection\": ccrs.PlateCarree()})\n",
    "ax.add_feature(cfeature.LAND, facecolor=\"#e8e4d8\", zorder=1)\n",
    "ax.coastlines(resolution=\"10m\", linewidth=0.8, zorder=20)\n",
    "\n",
    "legend_handles = []\n",
    "for i, (label, (grid, color, step)) in enumerate(GRIDS.items()):\n",
    "    lon2d, lat2d = grid.tlon.values, grid.tlat.values\n",
    "    if \"parent\" in label:\n",
    "        lon2d, lat2d = crop_mesh(lon2d, lat2d, LON_CROP, LAT_CROP)\n",
    "    z = i * 2\n",
    "    draw_mesh(ax, lon2d, lat2d, step, color, zorder=z)\n",
    "    lon0, lon1 = np.nanmin(grid.tlon.values), np.nanmax(grid.tlon.values)\n",
    "    lat0, lat1 = np.nanmin(grid.tlat.values), np.nanmax(grid.tlat.values)\n",
    "    ax.add_patch(mpatches.Rectangle((lon0, lat0), lon1 - lon0, lat1 - lat0,\n",
    "                                     fill=False, edgecolor=color, linewidth=1.6, zorder=z + 1,\n",
    "                                     transform=ccrs.PlateCarree()))\n",
    "    ny, nx = grid.tlon.shape\n",
    "    legend_handles.append(mpatches.Patch(edgecolor=color, facecolor=\"none\",\n",
    "                                          label=f\"{label} — {nx}×{ny} pts, {lon0:.1f}→{lon1:.1f} lon, {lat0:.1f}→{lat1:.1f} lat\"))\n",
    "\n",
    "ax.set_extent([*LON_CROP, *LAT_CROP], crs=ccrs.PlateCarree())\n",
    "gl = ax.gridlines(draw_labels=True, linewidth=0.3, color=\"gray\", alpha=0.4, zorder=0)\n",
    "gl.top_labels = False\n",
    "gl.right_labels = False\n",
    "ax.set_title(\"Caribbean nesting hierarchy — grid footprints (no bathymetry, geometry only)\")\n",
    "ax.legend(handles=legend_handles, loc=\"upper center\", bbox_to_anchor=(0.5, -0.05), fontsize=8, frameon=False)\n",
    "fig.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-7",
   "metadata": {},
